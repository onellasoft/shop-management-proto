# ============================================================================
# Docker Compose environment. Copy to `.env` and adjust as needed:
#     cp .env.example .env
# Compose reads this file automatically for ${VAR} substitution.
# ============================================================================

# --- Deployment environment: development | staging | production ---
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=onella
POSTGRES_PASSWORD=onella
POSTGRES_DB=onella
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8000
# Secret used to sign JWTs. CHANGE THIS in staging/production.
JWT_SECRET=change-me-in-development
# Apply DB migrations on backend startup (1) or skip and run manually (0).
RUN_MIGRATIONS=1
# Allowed browser origins for CORS (comma-separated). Use * for any (dev only).
CORS_ORIGINS=http://localhost:4300

# --- Frontend ---
FRONTEND_PORT=4300
